{
  "name": "@agrisense/backend",
  "version": "1.0.0",
  "description": "AgriSense IoT Node/Express/TypeScript backend server and multi-analyzer engine",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
